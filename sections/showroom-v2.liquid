{%- liquid
  assign color = section.settings.color
  assign bg_color = section.settings.bg_color
  assign bt_color = section.settings.bt_color
  assign bt_bg = section.settings.bt_bg
  assign card_bg = section.settings.card_bg

  assign title = section.settings.title
  assign subtitle = section.settings.subtitle
  assign box_per_row = section.settings.box_per_row

  assign sort_by_alphabetical = section.settings.sort_by_alphabetical
  assign sort_by_location = section.settings.sort_by_location
  assign sort_by_state = section.settings.sort_by_state

  assign default_sort_option = section.settings.default_sort_option

  assign limit = section.settings.limit

  assign button = section.settings.button
  assign button_link = section.settings.button_url

  assign padding_top = section.settings.padding_top
  assign padding_bot = section.settings.padding_bot
  assign padding_top_mob = section.settings.padding_top_mob
  assign padding_bot_mob = section.settings.padding_bot_mob

  assign border_top = section.settings.border_top
  assign border_bot = section.settings.border_bot
-%}

<style>
.showroom .section-boxed-column {
  order: var(--order);
}

#shopify-section-{{ section.id }} {
  --color: {{ color }};
  --bg-color: {{ bg_color }};
  --bt-color: {{ bt_color }};
  --bt-bg: {{ bt_bg }};
  --card-bg: {{ card_bg }};
  --buttonColor: #032e6a;
  --buttonHover: #000000;
  --padding-top: {{ padding_top }}px;
  --padding-bot: {{ padding_bot }}px;
  --padding-top-mob: {{ padding_top_mob }}px;
  --padding-bot-mob: {{ padding_bot_mob }}px;
}
</style>

<script src="{{ 'component-showroom.js' | asset_url }}" defer="defer"></script>

<section class="showroom showroom-{{ section.id }}"{% if template.name == 'product' %} id="pdp-showroom-section"{% endif %}>
{%- if border_top == true -%}
  <div class="border-top">
    <div class="section-divider"></div>
  </div>
{%- endif -%}
{%- liquid
    if section.settings.get_data_from_metaobject
        assign showrooms = shop.metaobjects.showroom.values
        assign showroom_count = showrooms.count
        if sort_by_state
            assign state_list = ''
            assign state_list_uniq = ''
            
            for showroom in showrooms
                assign state = showroom.state
                if forloop.first
                    assign state_list = state
                else
                    assign state_list = state_list | append: ',' | append: state
                endif
            endfor
            
            if state_list != blank
                assign state_list = state_list | split: ','
                assign state_list_uniq = state_list | uniq | sort
            endif
        endif
    endif
-%}

<showroom-items class="section-boxed" column="1" column-lg="{{ box_per_row }}"{% if limit != blank %} data-limit="{{ limit }}"{% endif %}{% if default_sort_option != blank %} data-default-sort-by="{{ default_sort_option }}"{% endif %}>
  <div class="showroom-section-header{% if sort_by_alphabetical or sort_by_state %} has-filter-option{% endif %}">
    {%- if title != blank or subtitle != blank -%}
        <div class="section-header">
          {%- if title -%}
              <h2 class="section-title">{{ title }}</h2>
          {%- endif -%}
          {%- if subtitle != blank -%}
              <p class="section-subtitle">{{ subtitle }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if sort_by_alphabetical or sort_by_state -%}
      <div class="showroom-sort-option-wrapper">
        {% if sort_by_location %}
            <button class="showroom-sort-option{% if default_sort_option == 'sort_by_location' %} active{% endif %}" data-sort-by="by_location">Near Me</button>
        {% endif %}
        {% if sort_by_alphabetical %}
            <button class="showroom-sort-option{% if default_sort_option == 'sort_by_alphabetical' %} active{% endif %}" data-sort-by="by_alphabetical">All Showrooms{% if showroom_count > 1 %} ({{ showroom_count }}){% endif %}</button>
        {% endif %}
        {%- if sort_by_state -%}
            {%- for state_uniq in state_list_uniq -%}
                {%- liquid
                    assign count = 0
                    for state in state_list
                        if state_uniq == state
                            assign count = count | plus: 1
                        endif
                    endfor
                -%}
                <button class="showroom-sort-option" data-sort-by="by_state" data-sort-option="{{ state_uniq }}">{{ state_uniq }}{% if count > 1 %} ({{ count }}){% endif %}</button>
            {%- endfor -%}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
  
  <div class="section-boxed-row">
    {%- if section.settings.get_data_from_metaobject -%}
      {% assign showrooms = shop.metaobjects.showroom.values %}
      {% assign showroom_data_string = '' %}
      {% for showroom in showrooms %}
        {%- liquid
            assign title = showroom.title
            assign appointment_text = showroom.appointment_status
            assign showroom_address = showroom.address
            assign state = showroom.state
            assign button_text = showroom.button_label
            assign button_url = showroom.button_url
            assign text = showroom.description
            assign longitude = showroom.longitude
            assign latitude = showroom.latitude
            assign image = showroom.image

            assign title_handle = title | strip_html | handle
            assign clean_title = title | replace: '<br>', ' '
            assign object = '{' | append: '"handle":"' | append: title_handle | append: '",' | append: '"title":"' | append: clean_title | append: '",' | append: '"state":"' | append: state | append: '",' | append: '"longitude":"' | append: longitude | append: '",' | append: '"latitude":"' | append: latitude | append: '"}'
              
              if forloop.first
                assign showroom_data_string = object
              else
                assign showroom_data_string = showroom_data_string | append: ',' | append: object
              endif
          -%}
        
        <div class="section-boxed-column" data-showroom-order data-handle="{{ title_handle }}" style="--order:{{forloop.index0}}">
          <div class="showroom-card">
            <div class="showroom-card__header">
              {%- if title != blank -%}
                  <h2 class="showroom-card__title">{{ title }}</h2>
              {%- endif -%}
              {%- if appointment_text != blank or showroom_address != blank -%}
                <ul class="showroom-card__meta">
                  {%- if appointment_text != blank -%}
                  <li class="showroom-card__meta-item"><img src="{{ 'wall-clock.svg' | file_url }}" width="100%" height="100%" loading="lazy"><span>{{ appointment_text }}</span></li>
                  {%- endif -%}
                  {%- if showroom_address != blank -%}
                  <li class="showroom-card__meta-item"><img src="{{ 'pin.svg' | file_url }}" width="100%" height="100%" loading="lazy"><span class="showroom-card__address">{{ showroom_address }}</span></li>
                  {%- endif -%}
                </ul>
              {%- endif -%}
            </div>
            {%- if button_text != blank -%}
                <a href="{{ button_url }}" traget="_blank" rel="nofollow noopener noreferrer" class="showroom-card__button" data-calendly-opener>{{ button_text }}</a>
            {%- endif -%}
            {%- if text != blank or image != blank -%}
            <div class="showroom-card__footer gallery-inline">
                  <div class="showroom-card__text-gallery-inline">
                  {%- if image != blank -%}
                      <div class="showroom-card__gallery-inline">
                          <div class="showroom-card__gallery-item">
                            <a href="{{ image | img_url: '1000x' }}" data-fancybox="gallery-item-{{ block.id }}">
                              <img src="{{ image | img_url: '500x500' , crop: 'center' }}" alt="{{ image.alt | escape }}" width="100%" height="100%" loading="lazy">
                            </a>
                          </div>
                      </div>
                  {%- endif -%}
                  {%- if text != blank -%}
                      <div class="showroom-card__text-inline">{{ text }}</div>
                  {%- endif -%}
                  </div>
            </div>
            {%- endif -%}
          </div>
        </div>
      {% endfor %}

      <script type="application/json" data-showroom-info>
        [{{ showroom_data_string }}]
      </script>
    {%- endif -%}
  </div>
  {%- if button != blank and button_link != blank -%}
    <div class="showroom-button-wrapper">
        <a href="{{ button_link }}" class="button">{{ button }}</a>
    </div>
  {%- endif -%}
</showroom-items>
{%- if border_bot == true -%}
  <div class="border-bot">
    <div class="section-divider"></div>
  </div>
{%- endif -%}
</section>

{% schema %}
{
 "name":"Showroom V2",
 "presets":[
    {
       "name":"Showroom V2"
    }
 ],
 "settings":[
    {
       "type":"text",
       "id":"title",
       "label":"Title",
       "default":"Find a Showroom"
    },
    {
       "type":"text",
       "id":"subtitle",
       "label":"Subtitle",
       "default": "EXPERIENCE “THE WORLDS GREATEST MODULAR SOFA” IN PERSON."
    },
    {
      "type": "checkbox",
      "id": "get_data_from_metaobject",
      "label": "Get data from Metaobject",
      "default": false
    },
    {
       "type":"range",
       "id":"box_per_row",
       "label":"Box per row",
       "min":1,
       "max":3,
       "step":1,
       "default":3
    },
    {
        "type": "text",
        "id": "button",
        "label": "Button label",
        "default": "See all showroom"
    },
    {
        "type": "url",
        "id": "button_url",
        "label": "Button URL"
    },
    {
        "type": "header",
        "content": "Sort Options"
    },
    {
        "type": "checkbox",
        "id": "sort_by_alphabetical",
        "label": "Sort by Alphabetical",
        "default": false,
        "info": "Display all showrooms sorted A–Z by title."
    },
    {
        "type": "checkbox",
        "id": "sort_by_location",
        "label": "Sort by Location",
        "default": true,
        "info": "Use the customer's location to show nearby showrooms first."
    },
    {
        "type": "checkbox",
        "id": "sort_by_state",
        "label": "Sort by State",
        "default": false,
        "info": "When a state is selected, only showrooms from that state will be shown."
    },
    {
        "type": "select",
        "id": "default_sort_option",
        "label": "Default sort option",
        "options": [
            {
                "value": "sort_by_location",
                "label": "Sort by Location"
            },
            {
                "value": "sort_by_alphabetical",
                "label": "Sort by Alphabetical"
            }
        ],
        "default": "sort_by_location"
    },
    {
        "type": "number",
        "id": "limit",
        "label": "Limit Nearby Showrooms",
        "default": 9,
        "info": "Maximum number of showrooms to display when sorting by location."
    },
    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "checkbox",
      "id": "border_top",
      "label": "Border top",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "border_bot",
      "label": "Border Bottom",
      "default": false
    },
    {
       "type":"header",
       "content":"color"
    },
    {
       "type":"color",
       "id":"color",
       "label":"Color",
       "default":"#000000"
    },
    {
       "type":"color",
       "id":"bg_color",
       "label":"Background color",
       "default":"#ffffff"
    },
    {
       "type":"color",
       "id":"card_bg",
       "label":"Card background color",
       "default":"#f3f3f3"
    },
    {
       "type":"color",
       "id":"bt_color",
       "label":"Button color",
       "default":"#ffffff"
    },
    {
       "type":"color",
       "id":"bt_bg",
       "label":"Button background",
       "default":"#000000"
    },
    {
      "type": "header",
      "content": "Specing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bot",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mob",
      "label": "Padding top(Mobile)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bot_mob",
      "label": "Padding bottom(Mobile)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 30
    }
 ]
}
{% endschema %}
