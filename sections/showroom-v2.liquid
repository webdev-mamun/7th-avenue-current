{%- liquid
  assign color = section.settings.color
  assign bg_color = section.settings.bg_color
  assign button_color = section.settings.button_color
  assign button_bg = section.settings.button_bg
  assign button_bg_hover = section.settings.button_bg_hover

  assign bt_color = section.settings.bt_color
  assign bt_bg = section.settings.bt_bg
  assign card_bg = section.settings.card_bg

  assign title = section.settings.title
  assign subtitle = section.settings.subtitle
  assign box_per_row = section.settings.box_per_row

  assign sort_by_alphabetical = section.settings.sort_by_alphabetical
  assign sort_by_location = section.settings.sort_by_location
  assign sort_by_state = section.settings.sort_by_state

  assign default_sort_option = ''
  if sort_by_alphabetical and sort_by_location
    assign default_sort_option = section.settings.default_sort_option
  elsif sort_by_alphabetical == false and sort_by_location == false
    assign default_sort_option = section.settings.default_sort_option
  elsif sort_by_alphabetical and sort_by_location == false
    assign default_sort_option = 'sort_by_alphabetical'
  elsif sort_by_alphabetical == false and sort_by_location
    assign default_sort_option = 'sort_by_location'
  endif

  assign show_filter = false
  if sort_by_alphabetical and sort_by_location
    assign show_filter = true
  elsif sort_by_alphabetical and sort_by_state
    assign show_filter = true
  elsif sort_by_location and sort_by_state
    assign show_filter = true
  endif

  assign limit = section.settings.limit

  assign button = section.settings.button
  assign button_link = section.settings.button_url

  assign share_enabled = section.settings.share_enabled

  assign padding_top = section.settings.padding_top
  assign padding_bot = section.settings.padding_bot
  assign padding_top_mob = section.settings.padding_top_mob
  assign padding_bot_mob = section.settings.padding_bot_mob

  assign border_top = section.settings.border_top
  assign border_bot = section.settings.border_bot
-%}

<style>
  .showroom .section-boxed-column {
    order: var(--order);
  }

  #shopify-section-{{ section.id }} {
    --color: {{ color }};
    --bg-color: {{ bg_color }};
    --bt-color: {{ bt_color }};
    --bt-bg: {{ bt_bg }};
    --card-bg: {{ card_bg }};

    --buttonText: {{ button_color }};
    --buttonColor: {{ button_bg }};
    --buttonHover: {{ button_bg_hover }};

    --padding-top: {{ padding_top }}px;
    --padding-bot: {{ padding_bot }}px;
    --padding-top-mob: {{ padding_top_mob }}px;
    --padding-bot-mob: {{ padding_bot_mob }}px;
  }
</style>

<script src="{{ 'component-showroom.js' | asset_url }}" defer="defer"></script>
{%- if share_enabled -%}
  <script src="{{ 'component-share-showroom-card.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<section
  class="showroom showroom-{{ section.id }}"
  {% if template.name == 'product' %}
    id="pdp-showroom-section"
  {% endif %}
>
  {%- if border_top == true -%}
    <div class="border-top">
      <div class="section-divider"></div>
    </div>
  {%- endif -%}
  {%- liquid
    if section.settings.get_data_from_metaobject
      assign showrooms = shop.metaobjects.showroom.values
      assign showroom_count = showrooms.count

      if showroom_count > limit
        if template.name == 'page' and page.handle == 'find-a-showroom'
          assign limit = showroom_count
        endif
      elsif showroom_count <= limit
        assign limit = showroom_count
      endif

      assign show_button = false
      if showroom_count > limit and limit != 0
        assign show_button = true
        if template.name == 'page' and page.url == button_link
          assign show_button = false
        endif
      endif

      if sort_by_state
        assign state_list = ''
        assign state_list_uniq = ''

        for showroom in showrooms
          assign state = showroom.state
          if forloop.first
            assign state_list = state
          else
            assign state_list = state_list | append: ',' | append: state
          endif
        endfor

        if state_list != blank
          assign state_list = state_list | split: ','
          assign state_list_uniq = state_list | uniq | sort
        endif
      endif
    endif
  -%}

  <showroom-items
    class="section-boxed"
    id="showroom-items-{{ section.id }}"
    column="1"
    column-lg="{{ box_per_row }}"
    {% if limit != blank %}
      data-limit="{{ limit }}"
    {% endif -%}
    {% if default_sort_option != blank %}
      data-default-sort-by="{{ default_sort_option }}"
    {% endif %}
  >
    <div class="showroom-section-header{% if show_filter %} has-filter-option{% endif %}">
      {%- if title != blank or subtitle != blank -%}
        <div class="section-header">
          {%- if title -%}
            <h2 class="section-title">{{ title }}</h2>
          {%- endif -%}
          {%- if subtitle != blank -%}
            <p class="section-subtitle">{{ subtitle }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if show_filter -%}
        <div class="showroom-sort-option-scroller">
          <div class="showroom-sort-option-wrapper">
            {% if sort_by_location and default_sort_option == 'sort_by_location' %}
              <button class="showroom-sort-option active" data-sort-by="sort_by_location">Near Me</button>
            {% endif %}

            {% if sort_by_alphabetical and default_sort_option == 'sort_by_alphabetical' %}
              <button class="showroom-sort-option active" data-sort-by="sort_by_alphabetical">
                All Showrooms{% if showroom_count > 1 %} ({{ showroom_count }}){% endif %}
              </button>
            {% endif %}

            {% if sort_by_location and default_sort_option == 'sort_by_alphabetical' %}
              <button class="showroom-sort-option" data-sort-by="sort_by_location">Near Me</button>
            {% endif %}

            {% if sort_by_alphabetical and default_sort_option == 'sort_by_location' %}
              <button class="showroom-sort-option" data-sort-by="sort_by_alphabetical">
                All Showrooms{% if showroom_count > 1 %} ({{ showroom_count }}){% endif %}
              </button>
            {% endif %}

            {%- if sort_by_state -%}
              {%- for state_uniq in state_list_uniq -%}
                {%- liquid
                  assign count = 0
                  for state in state_list
                    if state_uniq == state
                      assign count = count | plus: 1
                    endif
                  endfor
                -%}
                <button class="showroom-sort-option" data-sort-by="sort_by_state" data-sort-option="{{ state_uniq }}">
                  {{ state_uniq -}}
                  {%- if count > 0 %} ({{ count }}){% endif %}
                </button>
              {%- endfor -%}
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>

    <div class="section-boxed-row">
      {%- if section.settings.get_data_from_metaobject -%}
        {% assign showrooms = shop.metaobjects.showroom.values %}
        {% assign showroom_data_string = '' %}
        {% for showroom in showrooms %}
          {%- liquid
            assign title = showroom.title
            assign appointment_text = showroom.appointment_status
            assign showroom_address = showroom.address
            assign state = showroom.state
            assign button_text = showroom.button_label
            assign button_url = showroom.button_url
            assign text = showroom.description
            assign longitude = showroom.longitude
            assign latitude = showroom.latitude
            assign image = showroom.image

            assign title_handle = title | strip_html | handle
            assign clean_title = title | replace: '<br>', ' '
            assign object = '{' | append: '"handle":"' | append: title_handle | append: '",' | append: '"title":"' | append: clean_title | append: '",' | append: '"state":"' | append: state | append: '",' | append: '"longitude":"' | append: longitude | append: '",' | append: '"latitude":"' | append: latitude | append: '"}'

            if forloop.first
              assign showroom_data_string = object
            else
              assign showroom_data_string = showroom_data_string | append: ',' | append: object
            endif
          -%}

          <div
            class="section-boxed-column"
            id="{{ title_handle }}"
            data-showroom
            data-handle="{{ title_handle }}"
            style="--order:{{forloop.index0}}"
          >
            <div class="showroom-card">
              <div class="showroom-card__header">
                <div class="showroom-card__title-and-share">
                  {%- if title != blank -%}
                    <h2 class="showroom-card__title">{{ title }}</h2>
                  {%- endif -%}
                  {%- if share_enabled -%}
                    <share-showroom-card data-showroom-id="{{ title_handle }}">
                      {{ 'icon-share.svg' | inline_asset_content }}
                      <span class="share-showroom-card__tooltip share-showroom-card__tooltip--right" tooltip
                        >URL Copied to Clipboard</span
                      >
                    </share-showroom-card>
                  {%- endif -%}
                </div>
                {%- if appointment_text != blank or showroom_address != blank -%}
                  <ul class="showroom-card__meta">
                    {%- if appointment_text != blank -%}
                      <li class="showroom-card__meta-item">
                        <svg xmlns="http://www.w3.org/2000/svg" version="1.1" viewBox="0 0 490.7 490.7" width="20px">
                          <defs>
                            <style>
                             .cls-1 {
                                stroke: #000;
                                stroke-miterlimit: 10;
                                stroke-width: 5px;
                              }
                            </style>
                          </defs>
                          <g>
                            <g id="Capa_1">
                              <path class="cls-1" d="M245.3,7.8C114.4,7.8,7.8,114.4,7.8,245.3s106.5,237.5,237.5,237.5,237.5-106.5,237.5-237.5S376.3,7.8,245.3,7.8ZM245.3,462.2c-119.6,0-216.9-97.3-216.9-216.9S125.8,28.5,245.3,28.5s216.9,97.3,216.9,216.9-97.3,216.9-216.9,216.9h0Z"/>
                              <path class="cls-1" d="M345.6,331l-89.9-89.9V80.1c0-5.7-4.6-10.3-10.3-10.3s-10.3,4.6-10.3,10.3v165.2c0,2.7,1.1,5.4,3,7.3l92.9,92.9c2,2,4.7,3,7.3,3s5.3-1,7.3-3c4-4,4-10.6,0-14.6h0Z"/>
                            </g>
                          </g>
                        </svg>
                        <span>{{ appointment_text }}</span>
                      </li>
                    {%- endif -%}
                    {%- if showroom_address != blank -%}
                      <li class="showroom-card__meta-item">
                        <svg id="Capa_1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 272 368.16" width="20px">
                          <path d="M136,0C61.01,0,0,61.01,0,136c0,24.69,11.07,51.24,11.54,52.36,3.58,8.49,10.63,21.67,15.72,29.4l93.25,141.29c3.82,5.79,9.46,9.11,15.5,9.11s11.68-3.32,15.5-9.1l93.26-141.3c5.1-7.73,12.14-20.91,15.72-29.4.46-1.11,11.53-27.66,11.53-52.36,0-74.99-61.01-136-136-136ZM245.72,182.15c-3.19,7.61-9.76,19.87-14.33,26.8l-93.26,141.3c-1.84,2.79-2.42,2.79-4.26,0L40.62,208.95c-4.57-6.93-11.14-19.2-14.33-26.81-.14-.33-10.29-24.77-10.29-46.14,0-66.17,53.83-120,120-120s120,53.83,120,120c0,21.41-10.18,45.91-10.28,46.15Z"/>
                          <path d="M136,64.01c-39.7,0-72,32.3-72,72s32.3,72,72,72,72-32.3,72-72c0-39.7-32.3-72-72-72ZM136,192.01c-30.87,0-56-25.12-56-56s25.13-56,56-56,56,25.12,56,56-25.13,56-56,56Z"/>
                        </svg>
                        <span class="showroom-card__address">{{ showroom_address }}</span>
                      </li>
                    {%- endif -%}
                  </ul>
                {%- endif -%}
              </div>
              {%- if button_text != blank -%}
                <a
                  href="{{ button_url }}"
                  traget="_blank"
                  rel="nofollow noopener noreferrer"
                  class="showroom-card__button"
                  data-calendly-opener
                >
                  {{- button_text -}}
                </a>
              {%- endif -%}
              {%- if text != blank or image != blank -%}
                <div class="showroom-card__footer gallery-inline">
                  <div class="showroom-card__text-gallery-inline">
                    {%- if image != blank -%}
                      <div class="showroom-card__gallery-inline">
                        <div class="showroom-card__gallery-item">
                          <a href="{{ image | img_url: '1000x' }}" data-fancybox="gallery-item-{{ block.id }}">
                            <img
                              src="{{ image | img_url: '500x500' , crop: 'center' }}"
                              alt="{{ image.alt | escape }}"
                              width="100%"
                              height="100%"
                              loading="lazy"
                            >
                          </a>
                        </div>
                      </div>
                    {%- endif -%}
                    {%- if text != blank -%}
                      <div class="showroom-card__text-inline">{{ text }}</div>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            </div>
          </div>
        {% endfor %}

        <script type="application/json" data-showroom-info>
          [{{ showroom_data_string }}]
        </script>
      {%- endif -%}
    </div>
    {%- if button != blank and button_link != blank and show_button -%}
      <div class="showroom-button-wrapper">
        <a href="{{ button_link }}" class="button">{{ button }}</a>
      </div>
    {%- endif -%}
  </showroom-items>
  {%- if border_bot == true -%}
    <div class="border-bot">
      <div class="section-divider"></div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
 "name":"Showroom V2",
 "presets":[
    {
       "name":"Showroom V2"
    }
 ],
 "settings":[
    {
       "type":"text",
       "id":"title",
       "label":"Title",
       "default":"Find a Showroom"
    },
    {
       "type":"text",
       "id":"subtitle",
       "label":"Subtitle",
       "default": "EXPERIENCE “THE WORLDS GREATEST MODULAR SOFA” IN PERSON."
    },
    {
      "type": "checkbox",
      "id": "get_data_from_metaobject",
      "label": "Get data from Metaobject",
      "default": false
    },
    {
       "type":"range",
       "id":"box_per_row",
       "label":"Box per row",
       "min":1,
       "max":3,
       "step":1,
       "default":3
    },
    {
        "type": "text",
        "id": "button",
        "label": "Button label",
        "default": "See all showrooms"
    },
    {
        "type": "url",
        "id": "button_url",
        "label": "Button URL"
    },
    {
      "type": "checkbox",
      "id": "share_enabled",
      "label": "Enable Share Button",
      "default": false
    },
    {
        "type": "header",
        "content": "Sort Options"
    },
    {
      "type": "paragraph",
      "content": "Sort options will only appear on the storefront if more than one sorting method is enabled below. If only one option is active, it will be applied automatically without showing a sort selector to customers."
    },
    {
        "type": "checkbox",
        "id": "sort_by_alphabetical",
        "label": "Sort by Alphabetical",
        "default": false,
        "info": "Display all showrooms sorted A–Z by title."
    },
    {
        "type": "checkbox",
        "id": "sort_by_location",
        "label": "Sort by Location",
        "default": true,
        "info": "Use the customer's location to show nearby showrooms first."
    },
    {
        "type": "checkbox",
        "id": "sort_by_state",
        "label": "Sort by State",
        "default": false,
        "info": "When a state is selected, only showrooms from that state will be shown."
    },
    {
      "type": "select",
      "id": "default_sort_option",
      "label": "Default sort option",
      "options": [
          {
              "value": "sort_by_location",
              "label": "Sort by Location"
          },
          {
              "value": "sort_by_alphabetical",
              "label": "Sort by Alphabetical"
          }
      ],
      "default": "sort_by_location",
      "info": "This setting is used only when both 'Sort by Location' and 'Sort by Alphabetical' are enabled, or when both are disabled. It determines which sorting method to prioritize by default."
    },
    {
      "type": "number",
      "id": "limit",
      "label": "Limit Nearby Showrooms",
      "default": 9,
      "info": "Sets the maximum number of showrooms to display when sorting by location. A value of 0 will show all nearby showrooms without any limit. Please note, this limit does not apply to the 'Find a Showroom' page."
    },
    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "checkbox",
      "id": "border_top",
      "label": "Border top",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "border_bot",
      "label": "Border Bottom",
      "default": false
    },
    {
       "type":"header",
       "content":"Section color"
    },
    {
       "type":"color",
       "id":"color",
       "label":"Color",
       "default":"#000000"
    },
    {
       "type":"color",
       "id":"bg_color",
       "label":"Background color",
       "default":"#ffffff"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_bg_hover",
      "label": "Button background (Hover)",
      "default": "#032e6a"
    },
    {
      "type": "header",
      "content": "Card color"
    },
    {
       "type":"color",
       "id":"card_bg",
       "label":"Background color",
       "default":"#f3f3f3"
    },
    {
       "type":"color",
       "id":"bt_color",
       "label":"Button color",
       "default":"#ffffff"
    },
    {
       "type":"color",
       "id":"bt_bg",
       "label":"Button background",
       "default":"#000000"
    },
    {
      "type": "header",
      "content": "Specing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bot",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mob",
      "label": "Padding top(Mobile)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bot_mob",
      "label": "Padding bottom(Mobile)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 30
    }
 ]
}
{% endschema %}
