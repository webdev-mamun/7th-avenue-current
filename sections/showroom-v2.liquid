{%- liquid
  assign color = section.settings.color
  assign bg_color = section.settings.bg_color
  assign bt_color = section.settings.bt_color
  assign bt_bg = section.settings.bt_bg
  assign card_bg = section.settings.card_bg
  assign title = section.settings.title
  assign title_mob = section.settings.title_mob
  assign subtitle = section.settings.subtitle
  assign subtitle_mob = section.settings.subtitle_mob
  assign box_per_row = section.settings.box_per_row
  assign padding_top = section.settings.padding_top
  assign padding_bot = section.settings.padding_bot
  assign padding_top_mob = section.settings.padding_top_mob
  assign padding_bot_mob = section.settings.padding_bot_mob
  assign border_top = section.settings.border_top
  assign border_bot = section.settings.border_bot
  assign active_geo = section.settings.active_geo
-%}

<style>
.showroom .section-boxed-column {
  order: var(--order);
}

#shopify-section-{{ section.id }} {
  --color: {{ color }};
  --bg-color: {{ bg_color }};
  --bt-color: {{ bt_color }};
  --bt-bg: {{ bt_bg }};
  --card-bg: {{ card_bg }};
  --padding-top: {{ padding_top }}px;
  --padding-bot: {{ padding_bot }}px;
  --padding-top-mob: {{ padding_top_mob }}px;
  --padding-bot-mob: {{ padding_bot_mob }}px;
  }
.active_geo .section-boxed-column.hide:not(.mobile-hide) {
  display: block;
}
.section-boxed-column.mobile-hide {
  display: none;
}
  @media screen and (min-width: 991px) {
    .active_geo .section-boxed-column.hide {
      display: none;
    }
    .section-boxed-column.mobile-hide:not(.hide) {
      display: block;
    }
  }
</style>

<script src="{{ 'component-showroom.js' | asset_url }}" defer="defer"></script>

<section class="showroom showroom-{{ section.id }}"{% if template.name == 'product' %} id="pdp-showroom-section"{% endif %}>
{%- if border_top == true -%}
  <div class="border-top">
    <div class="section-divider"></div>
  </div>
{%- endif -%}
{%- liquid
    assign sort_option_blocks = section.blocks | where: 'type', 'sort_option'
  assign default_sort_option = sort_option_blocks[0].settings.sort_by
-%}
<showroom-items class="section-boxed" column="1" column-lg="{{ box_per_row }}" data-default-sort-option="{{ default_sort_option }}">
  <div class="showroom-section-header">
    {%- if title != blank or subtitle != blank -%}
        <div class="section-header">
          {%- if title -%}
              <h2 class="section-title">{{ title }}</h2>
          {%- endif -%}
          {%- if subtitle != blank -%}
              <p class="section-subtitle">{{ subtitle }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- if sort_option_blocks.size > 1 -%}
      <div class="showroom-sort-option-wrapper">
        {%- for block in sort_option_blocks -%}
            <button class="showroom-sort-option{% if forloop.first %} active{% endif %}" data-sort-option="{{ block.settings.sort_by }}">{{ block.settings.title }}</button>
        {% endfor %}
      </div>
    {%- endif -%}
  </div>

  <style>
    showroom-items {
        display: block;
    }

    .showroom-section-header {
        display: grid;
        grid-template-columns: 1fr;
        align-items: center;
        gap: 20px;
    }

    .showroom-sort-option-wrapper {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: flex-end;
    }
    .showroom-sort-option {
        padding: 0.5rem 1rem;
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        border: 1px solid black;
        background-color: transparent;
        color: black;
        height: unset;
        line-height: unset;
        width: max-content;
        margin: 0;
        cursor: pointer;
        transition: all 0.2s ease-in-out;
      }
      
      .showroom-sort-option.active {
        background-color: black;
        color: white;
      }

      @media screen and (min-width: 750px) {
        .showroom-section-header {
            grid-template-columns: 1fr 1fr;
        }
    }
  </style>
  

  <div class="section-boxed-row{% if active_geo %} active_geo{% endif %}">
    {%- if section.settings.get_data_from_metaobject -%}
      {% assign showrooms = shop.metaobjects.showroom.values %}
      {% assign showroom_data_string = '' %}
      {% for showroom in showrooms %}
        {%- liquid
            assign title = showroom.title
            assign appointment_text = showroom.appointment_status
            assign showroom_address = showroom.address
            assign state = showroom.state
            assign button_text = showroom.button_label
            assign button_url = showroom.button_url
            assign text = showroom.description
            assign longitude = showroom.longitude
            assign latitude = showroom.latitude
            assign image = showroom.image

            assign title_handle = title | strip_html | handle
            assign clean_title = title | replace: '<br>', ' '
            assign object = '{' | append: '"handle":"' | append: title_handle | append: '",' | append: '"title":"' | append: clean_title | append: '",' | append: '"state":"' | append: showroom.state | append: '",' | append: '"longitude":"' | append: showroom.longitude | append: '",' | append: '"latitude":"' | append: showroom.latitude | append: '"}'
              
              if forloop.first
                assign showroom_data_string = object
              else
                assign showroom_data_string = showroom_data_string | append: ',' | append: object
              endif
            
          -%}
        
        <div class="section-boxed-column" data-showroom-order data-handle="{{ title_handle }}" style="--order:{{forloop.index0}}">
          <div class="showroom-card">
            <div class="showroom-card__header">
              {%- if title != blank -%}
                  <h2 class="showroom-card__title">{{ title }}</h2>
              {%- endif -%}
              {%- if appointment_text != blank or showroom_address != blank -%}
                <ul class="showroom-card__meta">
                  {%- if appointment_text != blank -%}
                  <li class="showroom-card__meta-item"><img src="{{ 'wall-clock.svg' | file_url }}" width="100%" height="100%" loading="lazy"><span>{{ appointment_text }}</span></li>
                  {%- endif -%}
                  {%- if showroom_address != blank -%}
                  <li class="showroom-card__meta-item"><img src="{{ 'pin.svg' | file_url }}" width="100%" height="100%" loading="lazy"><span class="showroom-card__address">{{ showroom_address }}</span></li>
                  {%- endif -%}
                </ul>
              {%- endif -%}
            </div>
            {%- if button_text != blank -%}
                <a href="{{ button_url }}" traget="_blank" rel="nofollow noopener noreferrer" class="showroom-card__button">{{ button_text }}</a>
            {%- endif -%}
            {%- if text != blank or image != blank -%}
            <div class="showroom-card__footer gallery-inline">
                  <div class="showroom-card__text-gallery-inline">
                  {%- if image != blank -%}
                      <div class="showroom-card__gallery-inline">
                          <div class="showroom-card__gallery-item">
                            <a href="{{ image | img_url: '1000x' }}" data-fancybox="gallery-item-{{ block.id }}">
                              <img src="{{ image | img_url: '500x500' , crop: 'center' }}" alt="{{ image.alt | escape }}" width="100%" height="100%" loading="lazy">
                            </a>
                          </div>
                      </div>
                  {%- endif -%}
                  {%- if text != blank -%}
                      <div class="showroom-card__text-inline">{{ text }}</div>
                  {%- endif -%}
                  </div>
            </div>
            {%- endif -%}
          </div>
        </div>
      {% endfor %}

      <script type="application/json" data-showroom-info>
        [{{ showroom_data_string }}]
      </script>

    {%- endif -%}
  </div>
</showroom-items>
{%- if border_bot == true -%}
  <div class="border-bot">
    <div class="section-divider"></div>
  </div>
{%- endif -%}
</section>

{% schema %}
{
 "name":"Showroom V2",
 "presets":[
    {
       "name":"Showroom V2"
    }
 ],
 "blocks": [
    {
    "type": "sort_option",
    "name": "Sort option",
    "settings": [
        {
            "type": "text",
            "id": "title",
            "label": "Option label"
        },
        {
        "type": "select",
        "id": "sort_by",
        "label": "Sort by",
        "options": [
            {
            "label": "Near Me",
            "value": "near_me"
            },
            {
                "label": "All Showrooms",
                "value": "all_showrooms"
            },
            {
            "label": "By State",
            "value": "by_state"
            }
        ],
        "default": "near_me"
        }
    ]
}
 ],
 "settings":[
    {
       "type":"text",
       "id":"title",
       "label":"Title",
       "default":"Find a Showroom"
    },
    {
       "type":"text",
       "id":"title_mob",
       "label":"Title (Mobile)",
       "default":"Find a Showroom"
    },
    {
       "type":"text",
       "id":"subtitle",
       "label":"Subtitle",
       "default": "EXPERIENCE “THE WORLDS GREATEST MODULAR SOFA” IN PERSON."
    },
    {
       "type":"text",
       "id":"subtitle_mob",
       "label":"Subtitle (Mobile)",
       "default": "EXPERIENCE “THE WORLDS GREATEST MODULAR SOFA” IN PERSON."
    },
    {
      "type": "checkbox",
      "id": "get_data_from_metaobject",
      "label": "Get data from Metaobject",
      "default": false
    },
    {
       "type":"range",
       "id":"box_per_row",
       "label":"Box per row",
       "min":1,
       "max":3,
       "step":1,
       "default":3
    },
    {
      "type": "checkbox",
      "id": "active_geo",
      "label": "show nearby locations first",
      "default": false
    },
    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "checkbox",
      "id": "border_top",
      "label": "Border top",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "border_bot",
      "label": "Border Bottom",
      "default": false
    },
    {
       "type":"header",
       "content":"color"
    },
    {
       "type":"color",
       "id":"color",
       "label":"Color",
       "default":"#000000"
    },
    {
       "type":"color",
       "id":"bg_color",
       "label":"Background color",
       "default":"#ffffff"
    },
    {
       "type":"color",
       "id":"card_bg",
       "label":"Card background color",
       "default":"#f3f3f3"
    },
    {
       "type":"color",
       "id":"bt_color",
       "label":"Button color",
       "default":"#ffffff"
    },
    {
       "type":"color",
       "id":"bt_bg",
       "label":"Button background",
       "default":"#000000"
    },
    {
      "type": "header",
      "content": "Specing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bot",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mob",
      "label": "Padding top(Mobile)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bot_mob",
      "label": "Padding bottom(Mobile)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 30
    }
 ]
}
{% endschema %}
